[Desktop Entry]
Type=Application
Name=Drivux
GenericName=Google Drive Client
GenericName[tr]=Google Drive İstemcisi
Comment=Mount Google Drive as a disk and keep folders in sync
Comment[tr]=Google Drive'ı disk olarak bağla ve klasörleri eşitle
Exec=drivux
Icon=io.github.abdullahnil.Drivux
Terminal=false
Categories=Network;FileTransfer;
Keywords=google;drive;gdrive;rclone;sync;mount;cloud;eşitleme;bulut;
StartupNotify=true
StartupWMClass=io.github.abdullahnil.Drivux
